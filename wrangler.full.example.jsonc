{
  "name": "sandy-sports-club",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/backend*",
      "/worker*",
      "/tests*",
      "/scripts*",
      "/studio/backend*",
      "/.git*",
      "/.env*",
      "/.dev.vars*",
      "/wrangler*",
      "/club-admin*",
      "/club-login*",
      "/member-home*",
      "/social-studio*",
      "/constitution*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandy-sports-club",
      "database_id": "REPLACE_WITH_NEW_SANDY_D1_UUID",
      "migrations_dir": "backend/migrations"
    }
  ],
  "vars": {
    "SANDY_CLUB_APPROVALS": "disabled",
    "SANDY_INVITES_ENABLED": "disabled",
    "SANDY_PRIVATE_LIBRARY_ENABLED": "disabled"
  }
}
