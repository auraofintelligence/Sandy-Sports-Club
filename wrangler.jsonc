{
  "name": "sandy-sports-club",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/backend*",
      "/worker*",
      "/tests*",
      "/scripts*",
      "/studio/backend*",
      "/.git*",
      "/.env*",
      "/.dev.vars*",
      "/wrangler*",
      "/club-admin*",
      "/club-login*",
      "/member-home*",
      "/social-studio*",
      "/constitution*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandy-sports-clubhouse",
      "database_id": "ada9c7fc-a138-4158-8986-8d6d6e8bfa94",
      "migrations_dir": "backend/migrations"
    },
    {
      "binding": "SANDY_SHOWCASE_DB",
      "database_name": "sandy-sports-clubhouse-showcase",
      "database_id": "fbc64621-a57a-43e7-8138-717576d167c2"
    }
  ],
  "vars": {
    "SANDY_CLUB_APPROVALS": "disabled",
    "SANDY_FOUNDING_MEMBERS": "enabled",
    "SANDY_TURNSTILE_SITE_KEY": "0x4AAAAAAGWn1PR25KcNBdiH",
    "SANDY_INVITES_ENABLED": "enabled",
    "SANDY_PRIVATE_LIBRARY_ENABLED": "disabled",
    "SANDY_NOMINATIONS_ENABLED": "disabled",
    "SANDY_SURVEY_ENABLED": "disabled"
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/15 * * * *"]
  }
}
