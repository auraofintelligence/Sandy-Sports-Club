{
  "name": "sandy-sports-clubhouse",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {"binding":"AI"},
  "triggers": {"crons":[]},
  "durable_objects": {"bindings":[{"name":"OFFICER_DEMOS","class_name":"OfficerDemoRoom"}]},
  "migrations": [{"tag":"sandy-officer-demo-v1","new_sqlite_classes":["OfficerDemoRoom"]}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sandy-sports-clubhouse",
    "database_id": "REPLACE_WITH_NEW_SANDY_D1_DATABASE_ID",
    "migrations_dir": "drizzle"
  },{
    "binding": "SHOWCASE_DB",
    "database_name": "sandy-sports-clubhouse-showcase",
    "database_id": "REPLACE_WITH_NEW_SANDY_SHOWCASE_D1_DATABASE_ID",
    "migrations_dir": "drizzle"
  }],
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/calendar.ics", "/calendar/*"]
  }
}
